{
  "bucket": "reports-001",
  "versioning": false,
  "lifecycle": [
    {
      "id": "expire-logs",
      "prefix": "logs/",
      "days": 30
    },
    {
      "id": "expire-scratch",
      "prefix": "scratch/",
      "days": 3
    }
  ],
  "notifications": [
    {
      "prefix": "incoming/",
      "queue": "ingest-q"
    }
  ],
  "policy": {
    "statements": [
      {
        "sid": "AllowRead",
        "effect": "Allow",
        "principal": "arn:role/reader",
        "action": "s3:GetObject",
        "resource": "reports-001/*"
      },
      {
        "sid": "DenyInsecure",
        "effect": "Deny",
        "principal": "*",
        "action": "s3:*",
        "resource": "reports-001/*",
        "condition": {
          "aws:SecureTransport": false
        }
      }
    ]
  }
}
